---
import { getDict, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section id="stack" class="section">
  <p class="route-label" data-reveal>GET /stack</p>
  <h2 class="section-h2 stack-h2" data-reveal>Stack</h2>
  <div class="stack-grid">
    {t.stackGroups.map((g) => (
      <div class="stack-card" data-reveal>
        <p class="stack-label">{g.label}</p>
        <div class="chip-row">
          {g.items.map((item) => <span class="stack-chip">{item}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

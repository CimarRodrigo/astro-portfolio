---
import { getDict, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section id="about" class="section">
  <p class="route-label" data-reveal>GET /about</p>
  <h2 class="section-h2 about-h2" data-reveal>{t.secAbout}</h2>
  <div class="about-body" data-reveal>
    <p>{t.aboutP1}</p>
    <p>{t.aboutP2}</p>
    <p>{t.aboutP3}</p>
  </div>
</section>

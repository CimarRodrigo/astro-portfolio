---
import { getDict, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">© 2026 Cimar Rodrigo Morales</p>
    <a
      href="https://github.com/CimarRodrigo"
      target="_blank"
      rel="noopener"
      class="footer-link"
    >{t.footBuilt} ⚡ Astro</a>
  </div>
</footer>

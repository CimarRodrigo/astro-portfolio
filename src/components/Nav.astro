---
import { getDict, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const sections = ['experience', 'projects', 'about', 'contact'];
---

<nav class="site-nav" aria-label="Main">
  <div class="nav-inner">
    <a href="#top" class="nav-logo">&gt;_ cimar</a>
    <div class="nav-links">
      {sections.map((id, i) => (
        <a href={`#${id}`} class="nav-link">{t.nav[i]}</a>
      ))}
    </div>
    <div class="nav-controls">
      <div class="lang-pill">
        <a
          href={localePath('en')}
          class:list={['lang-btn', { 'is-active': locale === 'en' }]}
          aria-label="English"
          aria-current={locale === 'en' ? 'true' : undefined}
          data-lang-switch
        >en</a>
        <a
          href={localePath('es')}
          class:list={['lang-btn', { 'is-active': locale === 'es' }]}
          aria-label="Español"
          aria-current={locale === 'es' ? 'true' : undefined}
          data-lang-switch
        >es</a>
      </div>
      <button class="theme-btn" aria-label="Toggle theme" data-theme-toggle>
        <span class="accent-dot"></span><span data-theme-label>dark</span>
      </button>
    </div>
  </div>
</nav>

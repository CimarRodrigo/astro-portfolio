---
import { getDict, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section id="experience" class="section">
  <p class="route-label" data-reveal>GET /experience</p>
  <h2 class="section-h2" data-reveal>{t.secExp}</h2>
  <div class="xp-list">
    {t.exp.map((job) => (
      <article class="xp-row" data-reveal>
        <div>
          <p class="xp-date">{job.date}</p>
          <p class="xp-loc">{job.loc}</p>
        </div>
        <div>
          <h3 class="xp-role">{job.role} <span class="xp-company">· {job.company}</span></h3>
          {job.desc && <p class="xp-desc">{job.desc}</p>}
          <ul class="xp-bullets">
            {job.bullets.map((b) => (
              <li class="xp-bullet"><span class="xp-marker" aria-hidden="true">&gt;</span><span>{b}</span></li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
